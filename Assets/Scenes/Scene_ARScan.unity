  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ARUIManager
  organsData:
  - organId: Jantung
    displayName: Jantung
    scientificName: (cor)
    primaryFunction: Memompa darah kaya oksigen ke seluruh tubuh dan menerima darah
      kotor kembali ke paru-paru.
  - organId: ParuParu
    displayName: Paru-Paru
    scientificName: (pulmo)
    primaryFunction: Tempat pertukaran gas oksigen (O2) dari udara luar dengan karbon
      dioksida (CO2) dari darah.
  - organId: Otak
    displayName: Otak
    scientificName: (encephalon)
    primaryFunction: Pusat kendali utama sistem saraf tubuh, mengatur gerakan, pikiran,
      memori, dan emosi.
  - organId: Hati
    displayName: Hati
    scientificName: (hepar)
    primaryFunction: Menyaring darah dari racun, memproduksi empedu untuk pencernaan,
      dan menyimpan cadangan energi.
  - organId: Lambung
    displayName: Lambung
    scientificName: (gaster)
    primaryFunction: Mencerna makanan secara mekanik dengan otot lambung dan kimiawi
      menggunakan asam lambung dan enzim.
  - organId: Ginjal
    displayName: Ginjal
    scientificName: (ren)
    primaryFunction: Menyaring zat sisa metabolisme dan cairan berlebih dari darah
      untuk dikeluarkan dalam bentuk urin.
  - organId: Usus
    displayName: Usus
    scientificName: (intestine)
    primaryFunction: Usus halus menyerap nutrisi makanan, sedangkan usus besar menyerap
      air dan membentuk sisa makanan.
  - organId: TulangRangka
    displayName: Tulang Rangka
    scientificName: (skeleton)
    primaryFunction: Menopang bentuk tubuh, melindungi organ dalam yang vital, dan
      tempat sel darah diproduksi.
  scanningPanel: {fileID: 1989026531}
  infoPanel: {fileID: 1184002434}
  organNameText: {fileID: 1428350398}
  scientificNameText: {fileID: 484644648}
  functionText: {fileID: 1068379811}
